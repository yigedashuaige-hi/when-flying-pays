    <!-- Mecanum wheel ground motion: libgazebo_ros_planar_move applies body-level planar
         velocity so the robot responds to /mecanum/cmd_vel without requiring a custom plugin.
         NOTE: wheel joints are set to revolute but visual spinning is not driven here;
         replace with a dedicated mecanum plugin when available in the build environment. -->
    <plugin name="mecanum_drive_plugin" filename="libgazebo_ros_planar_move.so">
      <commandTopic>/mecanum/cmd_vel</commandTopic>
      <odometryTopic>/odom_mecanum</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometryRate>50.0</odometryRate>
      <robotBaseFrame>base_link</robotBaseFrame>
    </plugin>

    <static>0</static>
    <plugin name='rotors_gazebo_imu_plugin' filename='librotors_gazebo_imu_plugin.so'>
      <robotNamespace/>
      <linkName>/imu_link</linkName>
      <imuTopic>/imu</imuTopic>
    </plugin>
  </model>
</sdf>
