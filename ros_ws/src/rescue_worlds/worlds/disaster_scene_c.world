<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="disaster_scene_c">
    <!-- Transport/ROS bridge is inert for ideal backend and required by RotorS. -->
    <plugin name="rotors_ros_interface_plugin"
            filename="librotors_gazebo_ros_interface_plugin.so" />
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <model name="rubble_wall">
      <static>true</static>
      <pose>6.9 0 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.55 3.6 1.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.55 3.6 1.10</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <model name="rubble_chunk_1">
      <static>true</static>
      <pose>4.2 0.9 0.30 0 0 0.35</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.6 0.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.6 0.60</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="rubble_chunk_2">
      <static>true</static>
      <pose>8.7 -1.1 0.35 0 0 -0.45</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.7 0.70</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.7 0.70</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="victim_marker">
      <static>true</static>
      <pose>11 0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
