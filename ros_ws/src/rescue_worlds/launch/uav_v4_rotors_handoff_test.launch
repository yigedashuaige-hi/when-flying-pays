<launch>
  <!-- Phase E1a-H isolated handoff harness: no mission policy or supervisor. -->
  <arg name="gui" default="false" />
  <arg name="headless" default="true" />
  <arg name="spawn_x" default="0.0" />
  <arg name="spawn_y" default="0.0" />
  <arg name="spawn_yaw" default="0.0" />
  <arg name="ground_controller" default="false" />

  <env name="GAZEBO_MODEL_PATH"
       value="$(optenv CATKIN_WS /workspace/ros_ws)/src:$(optenv CATKIN_WS /workspace/ros_ws)/src/rotors_simulator/rotors_gazebo/models:$(optenv GAZEBO_MODEL_PATH)" />
  <env name="GAZEBO_PLUGIN_PATH"
       value="$(optenv CATKIN_WS /workspace/ros_ws)/devel/lib:/opt/ros/noetic/lib:$(optenv GAZEBO_PLUGIN_PATH)" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find rescue_worlds)/worlds/disaster_scene_a.world" />
    <arg name="paused" value="false" />
    <arg name="use_sim_time" value="true" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="headless" value="$(arg headless)" />
  </include>

  <param name="uav_v4_handoff_description"
         command="$(find xacro)/xacro '$(find uav_v4)/urdf/uav_v4_rotors_native.urdf.xacro' ground_structure:=true ground_plugin:=true" />
  <node name="spawn_uav_v4" pkg="gazebo_ros" type="spawn_model"
        args="-param uav_v4_handoff_description -urdf -model uav_v4 -x $(arg spawn_x) -y $(arg spawn_y) -z 0.15 -Y $(arg spawn_yaw)"
        output="screen" />

  <rosparam command="load" file="$(find rescue_mission)/config/rotors_handoff_e1a_h.yaml" />
  <node pkg="rescue_mission" type="rotors_handoff_coordinator.py"
        name="rotors_handoff_coordinator" output="screen" />

  <group ns="uav_v4">
    <node pkg="rotors_control" type="lee_position_controller_node"
          name="lee_position_controller_node" output="screen">
      <rosparam command="load" file="$(find uav_v4)/config/lee_controller_uav_v4.yaml" />
      <rosparam command="load" file="$(find uav_v4)/config/uav_v4_rotors_native.yaml" />
      <remap from="command/motor_speed" to="command/motor_speed_raw" />
    </node>
  </group>

  <node pkg="rescue_mission" type="rotors_motor_gate.py"
        name="rotors_motor_gate" output="screen">
    <param name="handoff_managed" value="true" />
  </node>
  <node pkg="rescue_mission" type="rotors_odometry_bridge.py"
        name="rotors_odometry_bridge" output="screen" />
  <node pkg="rescue_mission" type="ground_goal_controller.py"
        name="ground_goal_controller" output="screen" if="$(arg ground_controller)" />
</launch>
