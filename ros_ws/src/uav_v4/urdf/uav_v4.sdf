    <joint name='wheel4_joint' type='revolute'>
      <pose relative_to='base_link'>-0.04 0.088 -0.015 0 -0 0</pose>
      <parent>base_link</parent>
      <child>wheel4_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='wheel4_link'>
      <pose relative_to='wheel4_joint'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>-0 -0.015719 0 0 -0 0</pose>
        <mass>0.037807</mass>
        <inertia>
          <ixx>4.513e-06</ixx>
          <ixy>7.8392e-23</ixy>
          <ixz>1.5946e-20</ixz>
          <iyy>5.9992e-06</iyy>
          <iyz>-1.9748e-21</iyz>
          <izz>4.513e-06</izz>
        </inertia>
      </inertial>
      <collision name='wheel4_link_collision'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://uav_v4/meshes/wheel4_link.STL</uri>
